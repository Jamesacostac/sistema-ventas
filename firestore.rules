rules_version = '2';

// Seguridad del Sistema de Ventas
//
// 1. ACCESO: para leer o escribir hay que ser administrador (admins/{uid}) y tener la
//    sesión de este dispositivo verificada (sesiones/{uid}_{auth_time}, la crea el
//    servidor de verificación después del código por correo o de un dispositivo de confianza).
//
// 2. PERMISOS (rangos): el titular (rol "principal") puede todo. Cada socio tiene un mapa
//    admins/{uid}.permisos con: ventas, ventas_editar, clientes, inventario, finanzas, socios.
//    Los permisos solo los cambia el servidor, a pedido del titular o de quien él autorice.
//
// 3. AUDITORÍA: todo documento que se crea o modifica lleva el sello modificadoPor /
//    modificadoEn / auditoriaId, y en la MISMA operación se debe crear el registro
//    auditoria/{auditoriaId} con el nombre del usuario y la hora del servidor. Las
//    eliminaciones crean auditoria/eliminar_{coleccion}_{id}. Si falta el registro,
//    la escritura se rechaza. Nadie (ni el titular) puede editar o borrar la auditoría.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Identidad y sesión ----------------

    // UID de la cuenta interna del servidor de verificación (no es un secreto)
    function esServidor() {
      return request.auth != null && request.auth.uid == 'UID_SERVIDOR';
    }

    function rutaPerfil() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function esAdmin() {
      return request.auth != null && exists(rutaPerfil());
    }

    function perfil() {
      return get(rutaPerfil()).data;
    }

    function idSesion() {
      return request.auth.uid + '_' + string(request.auth.token.auth_time);
    }

    function sesionVerificada() {
      return get(/databases/$(database)/documents/sesiones/$(idSesion())).data.expira > request.time;
    }

    function adminVerificado() {
      return esAdmin() && sesionVerificada();
    }

    // ---------------- Permisos ----------------

    function esTitular() {
      return perfil().rol == 'principal';
    }

    function puede(permiso) {
      return esTitular() || perfil().get('permisos', {}).get(permiso, false) == true;
    }

    // Campos del sello de auditoría que se agregan a cada documento
    function camposSello() {
      return ['modificadoPor', 'modificadoPorNombre', 'modificadoEn', 'auditoriaId'];
    }

    // La modificación solo toca los campos indicados (más el sello)
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos.concat(camposSello()));
    }

    // ---------------- Auditoría ----------------

    // Crear/modificar: el documento lleva el sello y existe su registro de auditoría en esta misma operación
    function auditado() {
      let registro = getAfter(/databases/$(database)/documents/auditoria/$(request.resource.data.auditoriaId)).data;
      return request.resource.data.modificadoPor == request.auth.uid
        && request.resource.data.modificadoEn == request.time
        && registro.uid == request.auth.uid
        && registro.fecha == request.time;
    }

    // Eliminar: existe auditoria/eliminar_{coleccion}_{id} creado en esta misma operación
    function eliminacionAuditada(coleccion, id) {
      let registro = getAfter(/databases/$(database)/documents/auditoria/$('eliminar_' + coleccion + '_' + id)).data;
      return registro.uid == request.auth.uid && registro.fecha == request.time;
    }

    function escribirConPermiso(permiso) {
      return adminVerificado() && puede(permiso) && auditado();
    }

    function eliminarConPermiso(permiso, coleccion, id) {
      return adminVerificado() && puede(permiso) && eliminacionAuditada(coleccion, id);
    }

    // ---------------- Colecciones de seguridad (las maneja el servidor) ----------------

    match /admins/{uid} {
      allow read: if esServidor()
        || (request.auth != null && request.auth.uid == uid)
        || adminVerificado();
      allow write: if esServidor();
    }

    match /sesiones/{id} {
      allow read: if esServidor() || (request.auth != null && id == idSesion());
      allow write: if esServidor();
    }

    match /dispositivos/{id} {
      allow read: if esServidor() || (adminVerificado() && resource.data.uid == request.auth.uid);
      allow write: if esServidor();
    }

    match /codigos/{id} {
      allow read, write: if esServidor();
    }

    // Registro de auditoría: se puede leer y crear (a nombre propio y con la hora del servidor),
    // nunca editar ni borrar.
    match /auditoria/{id} {
      allow read: if adminVerificado();
      allow create: if esServidor() || (
        adminVerificado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nombre == perfil().get('nombre', '')
        && request.resource.data.fecha == request.time
      );
      allow update, delete: if false;
    }

    // ---------------- Datos del negocio ----------------

    match /ventas/{id} {
      allow read: if adminVerificado();
      allow create: if escribirConPermiso('ventas');
      // Editar ventas, o (con permiso de clientes) solo cobrar / reasignar al cliente
      allow update: if escribirConPermiso('ventas_editar')
        || (escribirConPermiso('clientes') && soloCambia(['pagado', 'medioPago', 'fechaPago', 'clienteId', 'cliente']));
      allow delete: if eliminarConPermiso('ventas_editar', 'ventas', id);
    }

    match /productos/{id} {
      allow read: if adminVerificado();
      allow create: if escribirConPermiso('inventario');
      // Al vender se descuenta el stock: basta el permiso de ventas para tocar solo lotes/stock
      allow update: if escribirConPermiso('inventario')
        || (escribirConPermiso('ventas') && soloCambia(['lotes', 'stock']));
      allow delete: if eliminarConPermiso('inventario', 'productos', id);
    }

    match /categorias/{id} {
      allow read: if adminVerificado();
      allow create, update: if escribirConPermiso('inventario');
      allow delete: if eliminarConPermiso('inventario', 'categorias', id);
    }

    match /clientes/{id} {
      allow read: if adminVerificado();
      // Al fiar a un cliente nuevo se registra automáticamente: basta el permiso de ventas
      allow create: if escribirConPermiso('clientes') || escribirConPermiso('ventas');
      allow update: if escribirConPermiso('clientes');
      allow delete: if eliminarConPermiso('clientes', 'clientes', id);
    }

    match /gastos/{id} {
      allow read: if adminVerificado();
      allow create, update: if escribirConPermiso('finanzas');
      allow delete: if eliminarConPermiso('finanzas', 'gastos', id);
    }

    match /caja_base/{id} {
      allow read: if adminVerificado();
      allow create, update: if escribirConPermiso('finanzas');
      allow delete: if eliminarConPermiso('finanzas', 'caja_base', id);
    }

    // Configuración (token de Telegram): todos la leen, solo el titular la cambia (desde la consola)
    match /config/{id} {
      allow read: if adminVerificado();
      allow write: if false;
    }
  }
}
